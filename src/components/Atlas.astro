---
import Win from "./Win.astro";
import { buildAtlas, type PinInput } from "../lib/atlas";

interface Props {
  pins: PinInput[];
}
const { pins } = Astro.props;
const atlas = buildAtlas(pins);
const label = pins.length
  ? `ASCII world map with pins at ${pins.map((p) => p.label).join(" and ")}`
  : "ASCII world map";
---
<Win id="atlas" title="atlas.exe — roughly where we've been">
  <div class="ascii-wrap">
    <pre class="ascii" role="img" aria-label={label} style={`--cols: ${atlas.cols}`}>{atlas.rows.map((row) => (
      <Fragment>{row.map((s) => (s.pin ? <span class="pin">{s.t}</span> : s.t))}{"\n"}</Fragment>
    ))}</pre>
  </div>

  <ul class="legend">
    {atlas.pins.map((p) => (
      <li><span class="pin">{p.n}</span>{p.label}</li>
    ))}
  </ul>
  <p class="note">pins are added by hand in site.json, not read from photo metadata.</p>
</Win>

<style>
  .ascii-wrap { container-type: inline-size; }
  .ascii {
    margin: 0;
    overflow: hidden;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 8px; /* respaldo */
    font-size: calc(100cqw / (var(--cols) * 0.6)); /* las columnas siempre caben en el ancho */
    line-height: 1.2;
    white-space: pre;
    color: var(--ink);
  }
  .pin {
    display: inline-block;
    width: 1ch;
    text-align: center;
    font-weight: 600;
    color: var(--paper);
    background: var(--accent);
  }
  .legend .pin { width: 1.6em; margin-right: 2px; }
</style>
